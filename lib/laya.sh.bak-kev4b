# lib/laya.sh — ciclo de vida de laya (clasificador de prompts, CPU, no toca VRAM).
# Requiere lib/config.sh. Laya es opcional: si falta o falla, qwen sigue funcionando.
# Solo se mata el laya que arrancó esta sesión (LAYA_SPID); uno ajeno se respeta.

_laya_port_open() { (exec 3<>"/dev/tcp/127.0.0.1/$LAYA_PORT") 2>/dev/null; }

_laya_healthy() { curl -sf --max-time 1 "http://127.0.0.1:$LAYA_PORT/health" >/dev/null 2>&1; }

# ── Kev: kev.serve en CPU como backend alternativo (laya_server le reenvía las preguntas) ──
_kev_port_open() { (exec 3<>"/dev/tcp/127.0.0.1/$KEV_PORT") 2>/dev/null; }
_kev_healthy() { curl -sf --max-time 1 "http://127.0.0.1:$KEV_PORT/v1/models" >/dev/null 2>&1; }

# Backend efectivo: LAYA_BACKEND (menú / entorno) > "backend" de laya/config.json > laya.
_laya_backend() {
  local b="${LAYA_BACKEND:-}"
  [ -n "$b" ] || b="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("backend", "laya"))' "$LAYA_DIR/config.json" 2>/dev/null)"
  case "$b" in kev) echo kev ;; *) echo laya ;; esac
}

# Arranca kev.serve en CPU y espera a que responda (el puerto solo abre con el modelo ya cargado).
# Si ya hay un kev.serve sano en el puerto, lo reutiliza y no lo detiene al salir.
_kev_up() {
  _kev_healthy && return 0
  if _kev_port_open; then echo "kev: el puerto $KEV_PORT está ocupado por otro proceso" >&2; return 1; fi
  [ -x "$KEV_PY" ] || { echo "kev: no encuentro $KEV_PY (crea el venv: cd $KEV_DIR && uv sync --extra serve)" >&2; return 1; }
  mkdir -p "$(dirname "$KEV_LOG")" || return 1
  local _dev="${KEV_DEVICE:-cpu}"
  echo "kev: arrancando $KEV_RUN en ${_dev^^} (:$KEV_PORT; la primera vez descarga el modelo) ..."
  ( cd "$KEV_DIR" && { [ "$_dev" = cpu ] && export CUDA_VISIBLE_DEVICES=""; exec "$KEV_PY" -m kev.serve --run "$KEV_RUN" --device "$_dev" --port "$KEV_PORT"; } ) >"$KEV_LOG" 2>&1 &
  KEV_SPID=$!
  disown "$KEV_SPID" 2>/dev/null || true
  local t0=$SECONDS
  until _kev_healthy; do
    if ! kill -0 "$KEV_SPID" 2>/dev/null; then
      echo "kev: terminó prematuramente (ver $KEV_LOG)" >&2
      unset KEV_SPID; return 1
    fi
    if (( SECONDS - t0 >= KEV_TIMEOUT )); then
      echo "kev: timeout (${KEV_TIMEOUT}s) (ver $KEV_LOG)" >&2
      kill "$KEV_SPID" 2>/dev/null || true
      unset KEV_SPID; return 1
    fi
    sleep 1
  done
  echo "kev: listo en 127.0.0.1:$KEV_PORT"
}

_kev_down() {
  if [ -n "${KEV_SPID:-}" ]; then
    kill "$KEV_SPID" 2>/dev/null || true
    wait "$KEV_SPID" 2>/dev/null || true
    # el proceso se lanzó con disown: wait no lo espera; sin esto el siguiente arranque ve un kev medio muerto
    local _t0=$SECONDS
    while kill -0 "$KEV_SPID" 2>/dev/null; do
      if (( SECONDS - _t0 >= 30 )); then kill -9 "$KEV_SPID" 2>/dev/null || true; break; fi
      sleep 0.5
    done
    unset KEV_SPID
  fi
  return 0
}

# Crea el venv con laya la primera vez (una sola vez, necesita red).
_laya_ensure_venv() {
  [ -x "$LAYA_VENV/bin/python" ] && return 0
  echo "laya: creando venv en $LAYA_VENV ..." >&2
  mkdir -p "$(dirname "$LAYA_VENV")" || return 1
  python3 -m venv "$LAYA_VENV" || return 1
  "$LAYA_VENV/bin/pip" install --quiet laya 2>&1 | tail -n 1 >&2
  [ -x "$LAYA_VENV/bin/python" ] || return 1
  echo "laya: venv listo." >&2
}

_laya_up() {
  [ "${QWEN_LAYA:-1}" = 1 ] || return 0
  if [ ! -f "$LAYA_SERVER" ]; then
    echo "laya: no encuentro $LAYA_SERVER (se continúa sin laya)" >&2
    return 0
  fi
  if _laya_port_open; then
    echo "laya: ya corriendo en 127.0.0.1:$LAYA_PORT"
    return 0
  fi
  _laya_ensure_venv || { echo "laya: no se pudo preparar el venv (se continúa sin laya)" >&2; return 1; }

  local backend; backend="$(_laya_backend)"
  if [ "$backend" = kev ] && ! _kev_up; then
    echo "kev: no disponible (se usa el checkpoint de laya)" >&2
    backend=laya
  fi

  echo "laya: arrancando en 127.0.0.1:$LAYA_PORT (backend: $backend) ..."
  LAYA_PORT="$LAYA_PORT" LAYA_MODEL="$LAYA_MODEL" LAYA_BACKEND="$backend" KEV_PORT="$KEV_PORT" KEV_RUN="$KEV_RUN" \
    "$LAYA_VENV/bin/python" "$LAYA_SERVER" >/dev/null 2>&1 &
  LAYA_SPID=$!
  disown "$LAYA_SPID" 2>/dev/null || true

  local t0=$SECONDS
  until _laya_healthy; do
    if ! kill -0 "$LAYA_SPID" 2>/dev/null; then
      echo "laya: terminó prematuramente (se continúa sin laya)" >&2
      unset LAYA_SPID; return 1
    fi
    if (( SECONDS - t0 >= LAYA_TIMEOUT )); then
      echo "laya: timeout (${LAYA_TIMEOUT}s) (se continúa sin laya)" >&2
      kill "$LAYA_SPID" 2>/dev/null || true
      unset LAYA_SPID; return 1
    fi
    sleep 0.5
  done
  if [ "$backend" = kev ]; then
    echo "laya: listo en 127.0.0.1:$LAYA_PORT (backend: kev · $KEV_RUN en ${KEV_DEVICE:-cpu})"
  else
    echo "laya: listo en 127.0.0.1:$LAYA_PORT (modelo: ${LAYA_MODEL:-el de laya/config.json})"
  fi
}

_laya_down() {
  if [ -n "${LAYA_SPID:-}" ]; then
    kill "$LAYA_SPID" 2>/dev/null || true
    wait "$LAYA_SPID" 2>/dev/null || true
    unset LAYA_SPID
  fi
  _kev_down
  return 0
}

# Modo independiente (tecla 'l' del menú): laya solo, hasta pulsar Enter.
_laya_standalone() {
  _laya_up || return $?
  if [ -z "${LAYA_SPID:-}" ] && _laya_port_open; then
    echo "laya: ya estaba corriendo fuera de esta sesión; no lo detengo."
    return 0
  fi
  read -r -p "Pulsa Enter para detener laya... " _
  _laya_down
  echo "laya: detenido."
}

# ── claude-kev: kev en GPU sin CUDA graphs ──
# Uso: _kev_gpu_up [fast]   (fast = kev-0.8b; por defecto kev-4b)
# Incompatible con llama-server (Qwen 35B): ambos quieren la VRAM.
_kev_gpu_up() {
  local run="$CLAUDE_KEV_RUN" need="$CLAUDE_KEV_MIN_MIB"
  [ "${1:-}" = fast ] && { run="$CLAUDE_KEV_RUN_FAST"; need=5000; }
  if (exec 3<>"/dev/tcp/127.0.0.1/$QWEN_PORT") 2>/dev/null; then
    echo "kev: llama-server (:$QWEN_PORT) está activo y ocupa VRAM; ejecuta qwen-stop primero" >&2
    return 1
  fi
  local free
  free="$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits 2>/dev/null | head -n1 | tr -d ' ')"
  if [[ "$free" =~ ^[0-9]+$ ]] && (( free < need )); then
    echo "kev: solo ${free} MiB de VRAM libres (hacen falta ~${need})" >&2
    return 1
  fi
  # asignaciones temporales: las hereda el proceso que lanza _kev_up
  KEV_RUN="$run" KEV_DEVICE=gpu KEV_CUDA_GRAPHS="${KEV_CUDA_GRAPHS:-0}" _kev_up
}